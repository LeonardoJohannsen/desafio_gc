# Copie para .env e preencha. NUNCA envie o .env para o GitHub nem cole a chave em chats.
GEMINI_API_KEY=
# Confira no Google AI Studio qual modelo está disponível para você.
GEMINI_MODEL=gemini-3.5-flash-lite
# Janela em que o bot pode puxar conversa (hora cheia, relógio da demo)
HORARIO_INICIO=9
HORARIO_FIM=20

# Limites do Gemini (veja a página de limites no AI Studio e ajuste ao seu plano)
GEMINI_MAX_RPM=12                 # no máximo N chamadas por minuto (o bot espaça sozinho)
GEMINI_TENTATIVAS=5               # tentativas por modelo, com espera crescente
GEMINI_ESPERA_MAXIMA_S=45         # quanto tempo, no máximo, uma mensagem pode esperar a IA
GEMINI_MODEL_RESERVA=gemini-3.5-flash   # opcional: outro modelo (cada um costuma ter a sua cota)
# Trava por dia: o bot para de chamar o modelo ao atingir o número e guarda cota para a demo.
# Formato modelo:limite,modelo:limite. Ajuste ao que o AI Studio mostra para você.
GEMINI_LIMITE_DIARIO=gemini-3.5-flash-lite:450,gemini-3.5-flash:18
GEMINI_THINKING=minimal           # nível de raciocínio (minimal/low/medium/high). Classificar mensagem curta não precisa de mais

# 1 = carrega alertas, enquetes e mentorias fictícias para o painel do RH não nascer vazio (0 = só o cadastro básico)
DEMO_DADOS=1
